{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Nothing here is ever compiled by `tsc` - esbuild bundles the sources,
    // and esbuild transpiles one file at a time with no cross-file type
    // information. So the constructs that need the whole program to be
    // emitted correctly (a type re-exported without `export type`, a
    // `const enum` read from another file) would type-check clean here and
    // then be silently wrong in the bundle. This makes `tsc --noEmit` judge
    // the sources the way the bundler actually reads them.
    "isolatedModules": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
